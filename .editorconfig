# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.css]
indent_style = space
indent_size = 2

[*.{md,yml,yaml,toml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[public/assets/vendor/**]
# third-party code: keep upstream formatting
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
