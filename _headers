# Netlify response headers
# CSS/JS links in the HTML carry ?v=..., so bump that number whenever a file changes.
# Images have no version: give a changed image a new file name, or visitors keep the old one for up to a year.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Discovery files for search engines and AI crawlers: short cache so updates are picked up quickly
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Placeholder page stays out of search results
/coming-soon.html
  X-Robots-Tag: noindex, nofollow

# Generated at build time; must never be cached for long so env changes show up straight away
/firebase-config.js
  Cache-Control: public, max-age=0, must-revalidate
